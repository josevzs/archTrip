# Copia este archivo como scripts/publicar.env y rellénalo (publicar.env no entra en git).

# El número del viaje: el que sale en la dirección al abrirlo, #/viaje/12
VIAJE=12
# El nombre del proyecto en Cloudflare Pages: la página queda en https://<PROYECTO>.pages.dev
PROYECTO=japon-2026

# Del panel de Cloudflare (ver «Publicar un viaje para los alumnos» en el README)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Opcional: el puerto de archTrip en esta máquina (8000 de serie)
# ARCHTRIP_PORT=8000
# Opcional: cómo se llama a wrangler. Desde cron el PATH es mínimo: si no encuentra npx, pon la
# ruta entera (la que diga `which npx`), p. ej. WRANGLER="/usr/local/bin/npx --yes wrangler@4"
# WRANGLER="npx --yes wrangler@4"
